# Settings for the local development stack (compose.yaml) and the dev tools (ng serve proxy,
# npm scripts). Copy to .env (git-ignored), fill in the passwords, and change anything else as
# needed: every value below is also the default used when it is missing.
#
# Database names, users and passwords only take effect when a database volume is first created;
# after changing them, recreate the volumes: podman compose down -v && podman compose up -d

# --- Stack ---------------------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=hospital-records
# Host interface the published ports listen on; 127.0.0.1 keeps them off the network.
BIND_ADDRESS=127.0.0.1
POSTGRES_IMAGE=docker.io/library/postgres:18-alpine

# --- FHIR (HAPI) ---------------------------------------------------------------------------------
HAPI_IMAGE=docker.io/hapiproject/hapi:v8.12.0-2
# The frontend is written against FHIR R4.
FHIR_VERSION=R4
# Host port of the FHIR API (http://localhost:<port>/fhir), also used by ng serve and npm run seed.
FHIR_HTTP_PORT=8080
FHIR_DB_NAME=hapi
FHIR_DB_USER=hapi
FHIR_DB_PASSWORD=

# --- PACS (Orthanc) ------------------------------------------------------------------------------
ORTHANC_IMAGE=docker.io/orthancteam/orthanc:26.9.1
ORTHANC_NAME=hospital-records
# DICOM Application Entity Title other DICOM nodes send to (storescu -aec <AET>).
ORTHANC_DICOM_AET=HOSPITAL_RECORDS
# Login for the REST API and the Explorer UI (http://localhost:<ORTHANC_HTTP_PORT>).
ORTHANC_USER=orthanc
ORTHANC_PASSWORD=
ORTHANC_HTTP_PORT=8042
ORTHANC_DICOM_PORT=4242
ORTHANC_DB_NAME=orthanc
ORTHANC_DB_USER=orthanc
ORTHANC_DB_PASSWORD=
ORTHANC_VERBOSE=true

# --- Frontend dev server (ng serve) --------------------------------------------------------------
# Terminology server for ICD-10 / ICD-11 search; ng serve proxies /tx to it.
# HL7's public test server by default; point it at your own server for anything beyond testing.
TERMINOLOGY_URL=https://tx.fhir.org/r4
