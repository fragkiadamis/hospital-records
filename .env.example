# Copy to .env (git-ignored) and fill in. Read by `podman compose` automatically.
# The DB passwords are applied only when a database volume is first created.

FHIR_DB_PASSWORD=
ORTHANC_DB_PASSWORD=
ORTHANC_PASSWORD=

